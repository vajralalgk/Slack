# ===========================================
# Netflix Streaming Platform - Environment
# ===========================================

# Application
APP_NAME=netflix-streaming-platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-here
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=netflix_db
DB_USER=netflix_user
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 (Video & Image Storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=netflix-videos
S3_BUCKET_THUMBNAILS=netflix-thumbnails
S3_BUCKET_SUBTITLES=netflix-subtitles

# CloudFront CDN
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your-key-pair-id
CLOUDFRONT_PRIVATE_KEY_PATH=/path/to/private_key.pem

# Elasticsearch (Search & Recommendations)
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_CONTENT=netflix_content

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_TRANSCODE_PROFILES=240p,480p,720p,1080p,4k
MAX_UPLOAD_SIZE_MB=5000

# Email (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Stripe (Subscription Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
