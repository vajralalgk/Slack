# =============================================================================
# Enterprise Cloud Transformation Platform (ECTP) - Dev Environment Variables
# =============================================================================
# Author: Gopi Krishna Vajrala
# Purpose: Example variable values for the ECTP dev environment.
#          Copy this file to terraform.tfvars and fill in actual values.
#
# IMPORTANT SECURITY NOTES:
#   1. NEVER commit terraform.tfvars to version control (add to .gitignore)
#   2. NEVER put actual secrets (passwords, API keys) in this file
#   3. Use environment variables (TF_VAR_*) for sensitive values in CI/CD
#   4. ACM certificate ARN is the only truly variable input here
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # Edit terraform.tfvars with actual values
#   terraform plan -var-file="terraform.tfvars"
#   terraform apply -var-file="terraform.tfvars"
#
# Alternative: Set variables via environment variables:
#   export TF_VAR_container_image="123456789.dkr.ecr.us-east-1.amazonaws.com/ectp-app:v1.0.0"
#   export TF_VAR_acm_certificate_arn="arn:aws:acm:us-east-1:123456789:certificate/abc-123"
#   terraform apply
# =============================================================================

# -----------------------------------------------------------------------------
# Project Identification
# -----------------------------------------------------------------------------

# Project name used as a prefix for all resource names.
# WHY: Consistent naming enables cost allocation, IAM policy scoping,
#       and easy identification in the AWS console.
# CONSTRAINT: Must be lowercase alphanumeric with hyphens, 2-21 characters.
project_name = "ectp"

# Deployment environment tier.
# WHY: Controls resource sizing, security policies, and retention periods.
# VALUES: "dev", "staging", "prod"
environment = "dev"

# AWS region for all infrastructure.
# WHY: us-east-1 has the widest AWS service availability.
#       All data remains within US regions for FERPA compliance.
# ALTERNATIVE: "us-west-2" for disaster recovery or West Coast proximity.
aws_region = "us-east-1"

# -----------------------------------------------------------------------------
# VPC Networking
# -----------------------------------------------------------------------------

# VPC CIDR block defining the IP address range for the entire network.
# WHY: /16 provides 65,536 addresses for all subnets across all tiers.
# PLANNING: Ensure this does not overlap with:
#           - On-premises networks (if VPN/DirectConnect is used)
#           - Other VPCs in the same account (if peering is used)
#           - Partner organization networks
# EXAMPLE RANGES:
#   Dev:     10.0.0.0/16
#   Staging: 10.1.0.0/16
#   Prod:    10.2.0.0/16
vpc_cidr = "10.0.0.0/16"

# -----------------------------------------------------------------------------
# Container Configuration
# -----------------------------------------------------------------------------

# Docker image URI for the ECTP FastAPI application.
# FORMAT: {account_id}.dkr.ecr.{region}.amazonaws.com/{repo_name}:{tag}
# WHY: ECS Fargate pulls this image to run the application containers.
# SECURITY:
#   - Use a specific version tag (not "latest") for deterministic deployments
#   - Images should be scanned for vulnerabilities in ECR before deployment
#   - Use immutable image tags to prevent tag swapping attacks
# EXAMPLE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/ectp-app:v1.0.0"
container_image = "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/ectp-app:latest"

# Port the FastAPI application listens on inside the container.
# WHY: Must match the PORT environment variable and the Uvicorn/Gunicorn
#       binding configuration in the application Dockerfile.
# DEFAULT: 8000 is the standard FastAPI/Uvicorn port.
# SECURITY: Using a port above 1024 means the container process does not
#           need root privileges to bind to the port.
container_port = 8000

# -----------------------------------------------------------------------------
# HTTPS / TLS Configuration
# -----------------------------------------------------------------------------

# ACM certificate ARN for HTTPS on the Application Load Balancer.
# WHY: Required for the HTTPS listener (port 443) on the ALB.
#       All traffic to ECTP must be encrypted (FERPA requirement).
# HOW TO CREATE:
#   1. Request a certificate in ACM for your domain (e.g., dev.ectp.edu)
#   2. Validate via DNS or email
#   3. Copy the ARN here after validation
# ALTERNATIVE: Import an existing certificate if not using ACM.
# EXAMPLE: "arn:aws:acm:us-east-1:123456789012:certificate/abcdef-1234-5678-abcd-1234567890ab"
acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL database name.
# WHY: This is the initial database created on the RDS instance.
#       The FastAPI application connects to this database.
# NAMING: Use lowercase with underscores (PostgreSQL convention).
db_name = "ectp_db"

# Master username for the RDS instance.
# WHY: The master user has full privileges. The application should use
#       a less-privileged user created via database migrations.
# SECURITY: Avoid common names like "admin", "root", or "postgres"
#           to reduce the risk of credential guessing attacks.
db_master_username = "ectp_admin"

# -----------------------------------------------------------------------------
# Monitoring / Alerting
# -----------------------------------------------------------------------------

# Email address for receiving CloudWatch alarm notifications.
# WHY: SNS delivers alert emails for critical and warning alarms.
# NOTE: After terraform apply, you must confirm the SNS subscription
#       by clicking the link in the confirmation email.
# LEAVE EMPTY ("") to skip email subscriptions.
# EXAMPLE: "devops-team@university.edu"
alert_email = "devops@example.edu"
